{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "justatemp-frontend",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2024-01-29",
  "compatibility_flags": [
    "nodejs_als"
  ],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  }
}
