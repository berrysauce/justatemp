{
  "name": "frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "workers:preview": "npm run build && wrangler dev",
    "workers:deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/adapter-cloudflare": "^7.2.0",
    "@sveltejs/kit": "^2.20.6",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "svelte": "^4.2.19",
    "svelte-check": "^3.6.0",
    "typescript": "^5.0.0",
    "vite": "^5.4.20",
    "wrangler": "^4.152.0"
  },
  "type": "module",
  "dependencies": {
    "random-words": "^2.0.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
